# Backend credentials (never put these in frontend environment variables)
GOOGLE_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Use the exact connection string from your Supabase project dashboard.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Explicit local development overrides (optional; never used in production).
# APP_DATABASE_URL=sqlite:///research.db
# CHECKPOINT_DATABASE_URL=sqlite:///checkpoints.db

MAX_ACTIVE_RUNS_PER_USER=2
MAX_DAILY_RUNS_PER_USER=50
TAVILY_SEARCH_DEPTH=basic
# Optional current per-million token rates for your model. Search fees excluded.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
